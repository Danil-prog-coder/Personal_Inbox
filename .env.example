# Скопируйте в .env и заполните то, что нужно. Без ключей приложение запускается,
# но оценка сообщений моделью и подключение Gmail работать не будут.

# Языковая модель
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Gmail (Google Cloud Console → OAuth 2.0 Client ID, тип «Web application»)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Адреса. Значения ниже — для запуска без контейнеров (make run + make front).
# В docker compose фронт и API отдаёт один nginx, поэтому оба адреса —
# http://localhost:8080 (порт меняется переменной WEB_PORT).
APP_BASE_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:5173
ADDR=:8000

# docker compose: порт nginx и внешний адрес приложения.
# При смене WEB_PORT поменяйте и PUBLIC_URL — на него возвращается OAuth Gmail.
WEB_PORT=8080
PUBLIC_URL=http://localhost:8080

# Хранилища. Значения ниже — для запуска без контейнеров; в docker compose
# адреса подставляются автоматически (postgres:5432 и redis:6379).
DATABASE_URL=postgres://personalinbox:personalinbox@localhost:5432/personalinbox?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# Учётные данные Postgres для docker compose
POSTGRES_USER=personalinbox
POSTGRES_PASSWORD=personalinbox
POSTGRES_DB=personalinbox

# Служебное
ENABLE_SCHEDULER=1
# Проиграть очередь «новых» сообщений из референса при старте (демонстрация SSE)
DEMO_LIVE=0
