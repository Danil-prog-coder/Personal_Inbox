# Скопируйте в .env и заполните то, что нужно. Без ключей приложение запускается,
# но оценка сообщений моделью и подключение Gmail работать не будут.

# Языковая модель
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Gmail (Google Cloud Console → OAuth 2.0 Client ID, тип «Web application»)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Адреса
APP_BASE_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:5173
ADDR=:8000

# Секрет подписи сессионной cookie: смена ключа разлогинивает всех
SESSION_SECRET=

# Служебное
DATABASE_PATH=backend/personal_inbox.db
ENABLE_SCHEDULER=1
# Проиграть очередь «новых» сообщений из референса при старте (демонстрация SSE)
DEMO_LIVE=0
